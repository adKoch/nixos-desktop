{
  "theme": "One Dark",
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "buffer_font_family": "JetBrains Mono",
  "autosave": "on_focus_change",
  "vim_mode": true,
  "agent_servers": {
    "gemini": {
      "type": "custom",
      "command": "gemini",
      "args": [
        "acp"
      ]
    }
  },
  "lsp": {
    "nixd": {
      "binary": {
        "path": "nixd"
      }
    }
  },
  "languages": {
    "Nix": {
      "language_servers": [
        "nixd",
        "!nil"
      ]
    }
  }
}
