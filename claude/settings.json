{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "BASH_MAX_OUTPUT_LENGTH": "100000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "model": "opus",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voiceEnabled": true,
  "permissions": {
    "deny": [
      "mcp__terminal__read_terminal"
    ]
  },
  "deniedMcpServers": [
    {
      "serverName": "terminal"
    }
  ],
  "hooks": {"SessionStart":[{"matcher":"^(startup|resume|clear|compact|fork)$","hooks":[{"type":"command","command":"bash '/home/adam/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]}
}
